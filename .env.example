APP_NAME=Coach Digital
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=coaching

# Local secrets, generated with:
#   openssl rand -hex 32     -> JWT_SECRET
#   openssl rand -base64 24  -> PASSWORD_SALT
JWT_SECRET=
PASSWORD_SALT=

# Leave empty in development: the OTP code is printed in the server log
SENDGRID_API_KEY=

# Optional
# Sender of the emails and admin address given in the welcome email
MAIL_FROM=
ADMIN_URL=
ALLOWED_ORIGINS=
SUPERSET_HOST=
SUPERSET_USER=
SUPERSET_PASSWORD=
SUPERSET_DASHBOARD_ID=
